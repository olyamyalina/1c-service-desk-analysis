		<query>ВЫБРАТЬ
	ITЗаявка.Ссылка КАК Заявка,
	ITЗаявка.Дата КАК ДатаЗаявки,
	ITЗаявка.Заявитель КАК Заявитель,
	ITЗаявка.Категория КАК Категория,
	ITЗаявка.Приоритет КАК Приоритет,
	ITЗаявка.Исполнитель КАК Исполнитель,
	ITЗаявка.ТекущийСтатус КАК ТекущийСтатус,
	ITЗаявка.СрокРеакции КАК СрокРеакции,
	ITЗаявка.СрокРешения КАК СрокРешения,
	Реакция.ФактическаяРеакция КАК ФактическаяРеакция,
	Решение.ФактическоеРешение КАК ФактическоеРешение,
	НарушениеРеакции.ДатаНарушения КАК ДатаНарушенияРеакции,
	НарушениеРешения.ДатаНарушения КАК ДатаНарушенияРешения,

	ВЫБОР
		КОГДА ITЗаявка.СрокРеакции = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА "Срок не рассчитан"

		КОГДА Реакция.ФактическаяРеакция ЕСТЬ NULL
			ТОГДА
				ВЫБОР
					КОГДА ITЗаявка.ТекущийСтатус =
							ЗНАЧЕНИЕ(
								Перечисление.СтатусыЗаявок.Отменена
							)
						ТОГДА "Не применяется"

					КОГДА НарушениеРеакции.ДатаНарушения ЕСТЬ NULL
						ТОГДА "Не зафиксирована"

					ИНАЧЕ "Нарушено"
				КОНЕЦ

		КОГДА Реакция.ФактическаяРеакция &lt;= ITЗаявка.СрокРеакции
			ТОГДА "В срок"

		ИНАЧЕ "Нарушено"
	КОНЕЦ КАК РезультатРеакции,

	ВЫБОР
		КОГДА ITЗаявка.СрокРешения = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА "Срок не рассчитан"

		КОГДА Решение.ФактическоеРешение ЕСТЬ NULL
			ТОГДА
				ВЫБОР
					КОГДА ITЗаявка.ТекущийСтатус =
							ЗНАЧЕНИЕ(
								Перечисление.СтатусыЗаявок.Отменена
							)
						ТОГДА "Не применяется"

					КОГДА НарушениеРешения.ДатаНарушения ЕСТЬ NULL
						ТОГДА "Не решена"

					ИНАЧЕ "Нарушено"
				КОНЕЦ

		КОГДА Решение.ФактическоеРешение &lt;= ITЗаявка.СрокРешения
			ТОГДА "В срок"

		ИНАЧЕ "Нарушено"
	КОНЕЦ КАК РезультатРешения,

	1 КАК КоличествоЗаявок

ИЗ
	Документ.ITЗаявка КАК ITЗаявка

		ЛЕВОЕ СОЕДИНЕНИЕ
			(ВЫБРАТЬ
				ИсторияРеакции.Заявка КАК Заявка,
				МИНИМУМ(ИсторияРеакции.Период) КАК ФактическаяРеакция
			ИЗ
				РегистрСведений.ИсторияИзмененияСтатусов КАК ИсторияРеакции
			ГДЕ
				ИсторияРеакции.НовыйСтатус =
					ЗНАЧЕНИЕ(
						Перечисление.СтатусыЗаявок.ВРаботе
					)

			СГРУППИРОВАТЬ ПО
				ИсторияРеакции.Заявка) КАК Реакция
		ПО
			ITЗаявка.Ссылка = Реакция.Заявка

		ЛЕВОЕ СОЕДИНЕНИЕ
			(ВЫБРАТЬ
				ИсторияРешения.Заявка КАК Заявка,
				МИНИМУМ(ИсторияРешения.Период) КАК ФактическоеРешение
			ИЗ
				РегистрСведений.ИсторияИзмененияСтатусов КАК ИсторияРешения
			ГДЕ
				ИсторияРешения.НовыйСтатус =
					ЗНАЧЕНИЕ(
						Перечисление.СтатусыЗаявок.Решена
					)

			СГРУППИРОВАТЬ ПО
				ИсторияРешения.Заявка) КАК Решение
		ПО
			ITЗаявка.Ссылка = Решение.Заявка

		ЛЕВОЕ СОЕДИНЕНИЕ
			(ВЫБРАТЬ
				НарушенияРеакции.Заявка КАК Заявка,
				МАКСИМУМ(
					НарушенияРеакции.ДатаНарушения
				) КАК ДатаНарушения
			ИЗ
				РегистрСведений.НарушенияSLA КАК НарушенияРеакции
			ГДЕ
				НарушенияРеакции.ТипНарушения =
					ЗНАЧЕНИЕ(
						Перечисление.ТипыНарушенийSLA.НарушениеСрокаРеакции
					)

			СГРУППИРОВАТЬ ПО
				НарушенияРеакции.Заявка) КАК НарушениеРеакции
		ПО
			ITЗаявка.Ссылка = НарушениеРеакции.Заявка

		ЛЕВОЕ СОЕДИНЕНИЕ
			(ВЫБРАТЬ
				НарушенияРешения.Заявка КАК Заявка,
				МАКСИМУМ(
					НарушенияРешения.ДатаНарушения
				) КАК ДатаНарушения
			ИЗ
				РегистрСведений.НарушенияSLA КАК НарушенияРешения
			ГДЕ
				НарушенияРешения.ТипНарушения =
					ЗНАЧЕНИЕ(
						Перечисление.ТипыНарушенийSLA.НарушениеСрокаРешения
					)

			СГРУППИРОВАТЬ ПО
				НарушенияРешения.Заявка) КАК НарушениеРешения
		ПО
			ITЗаявка.Ссылка = НарушениеРешения.Заявка

ГДЕ
	ITЗаявка.ПометкаУдаления = ЛОЖЬ
	И ITЗаявка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
