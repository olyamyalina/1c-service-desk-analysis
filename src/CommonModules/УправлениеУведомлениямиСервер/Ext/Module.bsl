			|	РегистрСведений.УведомленияПользователей КАК УведомленияПользователей
			|ГДЕ
			|	УведомленияПользователей.Получатель = &Получатель
			|	И УведомленияПользователей.Заявка = &Заявка
			|	И УведомленияПользователей.Прочитано = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("Заявка", Заявка);
		Запрос.УстановитьПараметр("Получатель", ТекущийСотрудник);
		
		ТаблицаУведомлений = Запрос.Выполнить().Выгрузить();
   
	Исключение 
		Сообщить("Не удалось получить уведомления по заявке. " + ОписаниеОшибки());		
		Возврат Ложь;
   
    КонецПопытки;
		
	Если ТаблицаУведомлений.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	МоментПрочтения = ТекущаяДатаСеанса(); 
	
	НачатьТранзакцию();
	
	Попытка
	   Для каждого Уведомление Из ТаблицаУведомлений Цикл
		ЗаписьУведомления = РегистрыСведений.УведомленияПользователей.СоздатьМенеджерЗаписи();
			ЗаписьУведомления.Период = Уведомление.Период;
			ЗаписьУведомления.Получатель = Уведомление.Получатель;
			ЗаписьУведомления.Заявка = Уведомление.Заявка;
			ЗаписьУведомления.ТипУведомления = Уведомление.ТипУведомления;
			
			ЗаписьУведомления.Прочитать();
			Если ЗаписьУведомления.Выбран() И НЕ ЗаписьУведомления.Прочитано Тогда		
		    	ЗаписьУведомления.Прочитано = Истина;
				ЗаписьУведомления.ДатаПрочтения = МоментПрочтения;

				ЗаписьУведомления.Записать();

			КонецЕсли;
		КонецЦикла; 
			
	    ЗафиксироватьТранзакцию(); 
		
	Исключение
		ОтменитьТранзакцию();	
		Сообщить("Не удалось отметить уведомления прочитанными. " + ОписаниеОшибки());		
		Возврат Ложь;
	КонецПопытки; 
	
	Возврат Истина;
КонецФункции