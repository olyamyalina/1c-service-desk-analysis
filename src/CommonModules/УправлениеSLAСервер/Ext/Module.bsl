Функция ПолучитьПравилоSLA(Приоритет, ДатаЗаявки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Приоритет) ИЛИ НЕ ЗначениеЗаполнено(ДатаЗаявки) Тогда
		Возврат Неопределено;	
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПравилаSLAСрезПоследних.СрокРеакцииЧасы КАК СрокРеакцииЧасы,
		|	ПравилаSLAСрезПоследних.СрокРешенияЧасы КАК СрокРешенияЧасы
		|ИЗ
		|	РегистрСведений.ПравилаSLA.СрезПоследних(&ДатаЗаявки, Приоритет = &Приоритет) КАК ПравилаSLAСрезПоследних";
	
	Запрос.УстановитьПараметр("ДатаЗаявки", ДатаЗаявки);
	Запрос.УстановитьПараметр("Приоритет", Приоритет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураРезультата = Новый Структура; 
	СтруктураРезультата.Вставить("СрокРеакцииЧасы", Выборка.СрокРеакцииЧасы);
	СтруктураРезультата.Вставить("СрокРешенияЧасы", Выборка.СрокРешенияЧасы);
	Возврат СтруктураРезультата;

КонецФункции  

Функция ПолучитьИсториюЗаявки(Заявка) Экспорт   
	ИсторияЗаявки = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Заявка) Тогда
		Возврат ИсторияЗаявки;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
		 "ВЫБРАТЬ
		 |	ИсторияИзмененияСтатусов.Период КАК ДатаИзменения,
		 |	ИсторияИзмененияСтатусов.СтарыйСтатус КАК СтарыйСтатус,
		 |	ИсторияИзмененияСтатусов.НовыйСтатус КАК НовыйСтатус,
		 |	ИсторияИзмененияСтатусов.Пользователь КАК Пользователь,
		 |	ИсторияИзмененияСтатусов.Комментарий КАК Комментарий
		 |ИЗ
		 |	РегистрСведений.ИсторияИзмененияСтатусов КАК ИсторияИзмененияСтатусов
		 |ГДЕ
		 |	ИсторияИзмененияСтатусов.Заявка = &Заявка
		 |
		 |УПОРЯДОЧИТЬ ПО
		 |	ДатаИзменения ВОЗР"; 
		 
    Запрос.УстановитьПараметр("Заявка", Заявка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ПереходСтатуса = Новый Структура;
		ПереходСтатуса.Вставить("ДатаИзменения", Выборка.ДатаИзменения);
		ПереходСтатуса.Вставить("СтарыйСтатус", Выборка.СтарыйСтатус);
		ПереходСтатуса.Вставить("НовыйСтатус", Выборка.НовыйСтатус);
		ПереходСтатуса.Вставить("Пользователь", Выборка.Пользователь);
		ПереходСтатуса.Вставить("Комментарий", Выборка.Комментарий);
		ИсторияЗаявки.Добавить(ПереходСтатуса);	
	КонецЦикла;
	Возврат ИсторияЗаявки;
	
КонецФункции

Процедура ПроверитьНарушенияSLA() Экспорт
	МоментПроверки = ТекущаяДатаСеанса();
    ПустаяДата = Дата(1, 1, 1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ITЗаявка.Ссылка КАК Заявка,
		|	ITЗаявка.СрокРеакции КАК СрокРеакции,
		|	ITЗаявка.СрокРешения КАК СрокРешения,
		|	ITЗаявка.ДатаРеакции КАК ДатаРеакции,
		|	ITЗаявка.ДатаРешения КАК ДатаРешения
		|ИЗ
		|	Документ.ITЗаявка КАК ITЗаявка
		|ГДЕ
		|	ITЗаявка.ПометкаУдаления = ЛОЖЬ
		|	И (ITЗаявка.ДатаРеакции = &ПустаяДата
		|				И ITЗаявка.СрокРеакции <> &ПустаяДата
		|				И ITЗаявка.СрокРеакции < &МоментПроверки
		|			ИЛИ ITЗаявка.ДатаРешения = &ПустаяДата
		|				И ITЗаявка.СрокРешения <> &ПустаяДата
		|				И ITЗаявка.СрокРешения < &МоментПроверки)
		|	И ITЗаявка.ТекущийСтатус <> &Закрыта
		|	И ITЗаявка.ТекущийСтатус <> &Отменена";
	
	Запрос.УстановитьПараметр("МоментПроверки", МоментПроверки);
	Запрос.УстановитьПараметр("ПустаяДата", ПустаяДата);
	Запрос.УстановитьПараметр("Закрыта", Перечисления.СтатусыЗаявок.Закрыта);
	Запрос.УстановитьПараметр("Отменена", Перечисления.СтатусыЗаявок.Отменена);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		Если Выборка.ДатаРеакции = ПустаяДата
			И Выборка.СрокРеакции <> ПустаяДата
			И Выборка.СрокРеакции < МоментПроверки Тогда

			НарушениеЗаписано = ЗаписатьНарушениеSLA(Выборка.Заявка, Перечисления.ТипыНарушенийSLA.НарушениеСрокаРеакции, Выборка.СрокРеакции);
			
			Если НЕ НарушениеЗаписано Тогда
				Сообщить("Не удалось зарегистрировать нарушение срока реакции по заявке " + Строка(Выборка.Заявка) + ".");
			КонецЕсли;
		КонецЕсли;

		Если Выборка.ДатаРешения = ПустаяДата
			И Выборка.СрокРешения <> ПустаяДата
			И Выборка.СрокРешения < МоментПроверки Тогда

			НарушениеЗаписано = ЗаписатьНарушениеSLA(Выборка.Заявка, Перечисления.ТипыНарушенийSLA.НарушениеСрокаРешения, Выборка.СрокРешения);
			
			Если НЕ НарушениеЗаписано Тогда
				Сообщить("Не удалось зарегистрировать нарушение срока решения по заявке " + Строка(Выборка.Заявка) + ".");
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
	

КонецПроцедуры 

Функция ЗаписатьНарушениеSLA(Заявка, ТипНарушения, ДатаНарушения) Экспорт
	Если Не ЗначениеЗаполнено(Заявка) Тогда
		Сообщить("Не заполнена заявка.");
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипНарушения) Тогда
		Сообщить("Не заполнен тип нарушения.");
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНарушения) Тогда
		Сообщить("Не заполнена дата нарушения.");
		Возврат Ложь;
	КонецЕсли; 
	
    Попытка
		ЗаписьНарушения = РегистрыСведений.НарушенияSLA.СоздатьМенеджерЗаписи();
		ЗаписьНарушения.Заявка = Заявка;
		ЗаписьНарушения.ТипНарушения = ТипНарушения;
		ЗаписьНарушения.Прочитать();
		
		Если ЗаписьНарушения.Выбран() Тогда
			Возврат Истина;
		КонецЕсли;
 
		ЗаписьНарушения = РегистрыСведений.НарушенияSLA.СоздатьМенеджерЗаписи();

		ЗаписьНарушения.Заявка = Заявка;
		ЗаписьНарушения.ТипНарушения = ТипНарушения;
		ЗаписьНарушения.ДатаНарушения = ДатаНарушения;
		ЗаписьНарушения.Обработано = Ложь;

		ЗаписьНарушения.Записать();

		Возврат Истина;
		
	Исключение
		Сообщить("Не удалось записать нарушение SLA заявки " + Строка(Заявка) + ". " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ОбработатьНарушенияSLA(Заявка, ДатаРеакции, ДатаРешения, ТекущийСтатус, МоментОбработки) Экспорт
	Если НЕ ЗначениеЗаполнено(Заявка) Тогда
	Сообщить("Не указана заявка.");
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТекущийСтатус) Тогда
		Сообщить("Не указан статус заявки.");
		Возврат Ложь;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(МоментОбработки) Тогда
		Сообщить("Не указан момент обработки нарушений SLA.");
		Возврат Ложь;
	КонецЕсли;
	
	НачатьТранзакцию();

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	НарушенияSLA.ТипНарушения КАК ТипНарушения
			|ИЗ
			|	РегистрСведений.НарушенияSLA КАК НарушенияSLA
			|ГДЕ
			|	НарушенияSLA.Обработано = ЛОЖЬ
			|	И НарушенияSLA.Заявка = &Заявка";
		
		Запрос.УстановитьПараметр("Заявка", Заявка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НужноОбработать = Ложь;
			КомментарийОбработки = "";
			ТипУведомления = Перечисления.ТипыУведомлений.ПустаяСсылка();
			
			Если ТекущийСтатус = Перечисления.СтатусыЗаявок.Отменена Тогда
				НужноОбработать = Истина;
				КомментарийОбработки = "Заявка отменена.";

			ИначеЕсли ТекущийСтатус = Перечисления.СтатусыЗаявок.Закрыта Тогда
				НужноОбработать = Истина;
				КомментарийОбработки = "Заявка закрыта.";

			ИначеЕсли Выборка.ТипНарушения =
				Перечисления.ТипыНарушенийSLA.НарушениеСрокаРеакции
				И ЗначениеЗаполнено(ДатаРеакции) Тогда

				НужноОбработать = Истина;
				КомментарийОбработки = "Реакция по заявке зафиксирована.";

			ИначеЕсли Выборка.ТипНарушения =
				Перечисления.ТипыНарушенийSLA.НарушениеСрокаРешения
				И ЗначениеЗаполнено(ДатаРешения) Тогда

				НужноОбработать = Истина;
				КомментарийОбработки = "Решение по заявке зафиксировано.";

			КонецЕсли;   
			
			Если НЕ НужноОбработать Тогда
				Продолжить;
			КонецЕсли;
			
			Если Выборка.ТипНарушения = Перечисления.ТипыНарушенийSLA.НарушениеСрокаРеакции Тогда
				ТипУведомления = Перечисления.ТипыУведомлений.НарушениеСрокаРеакции;

			ИначеЕсли Выборка.ТипНарушения = Перечисления.ТипыНарушенийSLA.НарушениеСрокаРешения Тогда
				ТипУведомления = Перечисления.ТипыУведомлений.НарушениеСрокаРешения;

			Иначе
				ВызватьИсключение
					"Неизвестный тип нарушения SLA.";
			КонецЕсли; 
			
			ЗаписьНарушения = РегистрыСведений.НарушенияSLA.СоздатьМенеджерЗаписи();
			ЗаписьНарушения.Заявка = Заявка;
			ЗаписьНарушения.ТипНарушения = Выборка.ТипНарушения;
			ЗаписьНарушения.Прочитать();
			
			Если НЕ ЗаписьНарушения.Выбран() Тогда
				ВызватьИсключение
					"Не удалось получить запись нарушения SLA.";
			КонецЕсли;

			ЗаписьНарушения.Обработано = Истина;
			ЗаписьНарушения.ДатаОбработки = МоментОбработки;
			ЗаписьНарушения.Комментарий = КомментарийОбработки;
			ЗаписьНарушения.Записать();	
			
			УведомленияОбработаны = УправлениеУведомлениямиСервер.ОтметитьУведомленияОбработанными(Заявка, ТипУведомления, МоментОбработки);

			Если НЕ УведомленияОбработаны Тогда
				ВызватьИсключение
					"Не удалось обработать уведомления о нарушении SLA.";
			КонецЕсли;	
		КонецЦикла;  
		
		
        ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию(); 
		Сообщить("Не удалось обработать нарушения SLA по заявке " + Строка(Заявка) + ". " + ОписаниеОшибки());
		Возврат Ложь;	
	КонецПопытки;
	
	Возврат Истина;
КонецФункции