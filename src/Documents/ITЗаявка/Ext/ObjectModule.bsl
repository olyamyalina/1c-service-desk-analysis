	    Сообщить("Не удалось записать историю назначения исполнителя. " + "Запись заявки отменена. " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры 

Процедура ЗаписатьУведомлениеПоИзменениюСтатуса(Отказ, МоментИзменения)

	ПолучательУведомления = Неопределено;
	ТипУведомления = Перечисления.ТипыУведомлений.ПустаяСсылка();
	ТекстУведомления = "";

	Если ПредыдущийСтатус = Перечисления.СтатусыЗаявок.ВРаботе И ТекущийСтатус = Перечисления.СтатусыЗаявок.ОжидаетУточнения Тогда
		ПолучательУведомления = Заявитель;
		ТипУведомления = Перечисления.ТипыУведомлений.ЗапросУточнения;
	    ТекстУведомления = "Ваша заявка " + Строка(Ссылка) + " требует уточнения.";
	КонецЕсли;
	
	Если ПредыдущийСтатус = Перечисления.СтатусыЗаявок.ВРаботе И ТекущийСтатус = Перечисления.СтатусыЗаявок.ОжидаетОборудование Тогда
		ТекстУведомления = "По заявке " + Строка(Ссылка) + " требуется выдача или ремонт оборудования.";
		УведомленияЗаписаны = УправлениеУведомлениямиСервер.ЗаписатьУведомленияОтветственнымЗаОборудование(
					Ссылка,
					Перечисления.ТипыУведомлений.ТребуетсяРаботаСОборудованием,
					ТекстУведомления,
					МоментИзменения);

		Если НЕ УведомленияЗаписаны Тогда
			Отказ = Истина;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ПредыдущийСтатус = Перечисления.СтатусыЗаявок.ВРаботе И ТекущийСтатус = Перечисления.СтатусыЗаявок.Решена Тогда
		ПолучательУведомления = Заявитель;
		ТипУведомления = Перечисления.ТипыУведомлений.РешениеЗаявки;
	    ТекстУведомления = "Ваша заявка " + Строка(Ссылка) + " решена.";
	КонецЕсли;
	
	Если ПредыдущийСтатус = Перечисления.СтатусыЗаявок.Решена И ТекущийСтатус = Перечисления.СтатусыЗаявок.ВРаботе Тогда
		ПолучательУведомления = Исполнитель;
		ТипУведомления = Перечисления.ТипыУведомлений.ВозвратВРаботу;
	    ТекстУведомления = "Заявка " + Строка(Ссылка) + " возвращена в работу.";
	КонецЕсли; 
	
	Если ПредыдущийСтатус = Перечисления.СтатусыЗаявок.ОжидаетОборудование И ТекущийСтатус = Перечисления.СтатусыЗаявок.ВРаботе Тогда
		УведомленияОбработаны =УправлениеУведомлениямиСервер.ОтметитьУведомленияОбработанными(
					Ссылка,
					Перечисления.ТипыУведомлений.ТребуетсяРаботаСОборудованием,
					МоментИзменения);

		Если НЕ УведомленияОбработаны Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		ПолучательУведомления = Исполнитель;
		ТипУведомления = Перечисления.ТипыУведомлений.РаботаСОборудованиемЗавершена;
		ТекстУведомления = "Работа с оборудованием по заявке " + Строка(Ссылка) + " завершена. Можно продолжить выполнение заявки.";
	КонецЕсли;
	
	Если ПредыдущийСтатус = Перечисления.СтатусыЗаявок.ОжидаетОборудование И ТекущийСтатус = Перечисления.СтатусыЗаявок.Отменена Тогда
		УведомленияОбработаны = УправлениеУведомлениямиСервер.ОтметитьУведомленияОбработанными(
					Ссылка,
					Перечисления.ТипыУведомлений.ТребуетсяРаботаСОборудованием,
					МоментИзменения);

		Если НЕ УведомленияОбработаны Тогда
			Отказ = Истина;
		КонецЕсли;

		Возврат;
	КонецЕсли;

    Если ПолучательУведомления = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УведомлениеЗаписано =
		УправлениеУведомлениямиСервер.ЗаписатьУведомление(
				ПолучательУведомления,
				Ссылка,
				ТипУведомления,
				ТекстУведомления,
				МоментИзменения);

	Если НЕ УведомлениеЗаписано Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаписатьУведомленияРуководителямПоИзменениюСтатуса(Отказ, МоментИзменения)
	ТипУведомления = Перечисления.ТипыУведомлений.ПустаяСсылка();
	ТекстУведомления = "";
	
	Если Не ЗначениеЗаполнено(ПредыдущийСтатус) И ТекущийСтатус = Перечисления.СтатусыЗаявок.Новая Тогда
		ТипУведомления = Перечисления.ТипыУведомлений.ТребуетНазначения;
		ТекстУведомления = "Новая заявка " + Строка(Ссылка) + " ожидает назначения исполнителя.";
		
	ИначеЕсли ПредыдущийСтатус = Перечисления.СтатусыЗаявок.ВРаботе И ТекущийСтатус = Перечисления.СтатусыЗаявок.Решена Тогда
		ТипУведомления = Перечисления.ТипыУведомлений.ТребуетЗакрытия;
		ТекстУведомления = "Заявка " + Строка(Ссылка) + " решена и ожидает закрытия.";
	Иначе
		Возврат;
	КонецЕсли;
	
	УведомленияЗаписаны =
		УправлениеУведомлениямиСервер.ЗаписатьУведомленияРуководителям(
			Ссылка,
			ТипУведомления,
			ТекстУведомления,
			МоментИзменения);

	Если НЕ УведомленияЗаписаны Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура ЗакрытьНеактуальныеУведомленияРуководителей(Отказ, МоментИзменения)
	ТипУведомления = Перечисления.ТипыУведомлений.ПустаяСсылка();
	Если СохраненныеДанныеЗаявки <> Неопределено И НЕ ЗначениеЗаполнено(СохраненныеДанныеЗаявки.Исполнитель) И ЗначениеЗаполнено(Исполнитель) Тогда
		ТипУведомления = Перечисления.ТипыУведомлений.ТребуетНазначения;
	ИначеЕсли ПредыдущийСтатус = Перечисления.СтатусыЗаявок.Новая И ТекущийСтатус = Перечисления.СтатусыЗаявок.Отменена Тогда
		ТипУведомления = Перечисления.ТипыУведомлений.ТребуетНазначения;
	ИначеЕсли ПредыдущийСтатус = Перечисления.СтатусыЗаявок.Решена И (ТекущийСтатус = Перечисления.СтатусыЗаявок.Закрыта ИЛИ ТекущийСтатус = Перечисления.СтатусыЗаявок.ВРаботе) Тогда
		ТипУведомления = Перечисления.ТипыУведомлений.ТребуетЗакрытия;
	Иначе
		Возврат;
	КонецЕсли;	
	
	УведомленияОбработаны =
		УправлениеУведомлениямиСервер.ОтметитьУведомленияОбработанными(
			Ссылка,
			ТипУведомления,
			МоментИзменения);

	Если НЕ УведомленияОбработаны Тогда
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры       

Процедура ПриЗаписи(Отказ)
	МоментИзменения = ТекущаяДатаСеанса();
	Если ПредыдущийСтатус <> ТекущийСтатус Тогда 
		ЗаписатьИсториюИзмененияСтатуса(Отказ, МоментИзменения);
		Если Отказ = Истина Тогда
			Возврат;  
		КонецЕсли;
		
		ЗаписатьУведомлениеПоИзменениюСтатуса(Отказ, МоментИзменения); 
		Если Отказ = Истина Тогда
			Возврат;  
		КонецЕсли;
		
		ЗаписатьУведомленияРуководителямПоИзменениюСтатуса(Отказ, МоментИзменения);

		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если СохраненныеДанныеЗаявки <> Неопределено
	И Исполнитель <> СохраненныеДанныеЗаявки.Исполнитель Тогда
		ЗаписатьИсториюНазначенияИсполнителя(Отказ, МоментИзменения);
		Если Отказ = Истина Тогда
			Возврат;  
		КонецЕсли;  
		
		Если ЗначениеЗаполнено(СохраненныеДанныеЗаявки.Исполнитель) Тогда
			УведомленияОбработаны =
				УправлениеУведомлениямиСервер.ОтметитьУведомленияОбработанными(
					Ссылка,
					Перечисления.ТипыУведомлений.НазначениеЗаявки,
					МоментИзменения);

			Если НЕ УведомленияОбработаны Тогда
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЕсли;
	
		Если ЗначениеЗаполнено(Исполнитель) Тогда
			ТекстУведомления = "Вам назначена заявка " + Строка(Ссылка) + ".";

			УведомлениеЗаписано =
