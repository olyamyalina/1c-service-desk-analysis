Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если Не ЗначениеЗаполнено(Оформил) Тогда
		Попытка
			Оформил = УправлениеПользователямиСервер.ПолучитьТекущегоСотрудника();
		
		Исключение
			Сообщить("Не удалось определить сотрудника, оформляющего ремонт. " + ОписаниеОшибки());
			Отказ = Истина;
			Возврат;
		КонецПопытки; 
	
		Если Не ЗначениеЗаполнено(Оформил) Тогда
			Сообщить("Пользователь ИБ не связан с активным сотрудником.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ДатаОкончанияРемонта) Тогда
		Если ДатаОкончанияРемонта < Дата Тогда
			Сообщить("Дата окончания ремонта не может быть раньше даты начала ремонта.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
	    Если ДатаОкончанияРемонта > ТекущаяДатаСеанса() Тогда
			Сообщить("Дата окончания ремонта не может быть позже текущей даты.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если ПустаяСтрока(СокрЛП(РезультатРемонта)) Тогда
			Сообщить("Не заполнен результат ремонта.");
			Отказ = Истина;
			Возврат;	
		КонецЕсли;  
		
		Если НЕ ЗначениеЗаполнено(СостояниеПослеРемонта) Тогда
			Сообщить("Не указано состояние оборудования после ремонта.");
			Отказ = Истина;
			Возврат;
		КонецЕсли;

		Если СостояниеПослеРемонта = Перечисления.СостоянияОборудования.ВРемонте Тогда
			Сообщить("После завершения ремонта оборудование не может оставаться в состоянии ""В ремонте"".");
			Отказ = Истина;
			Возврат;
		КонецЕсли;
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ДатаОкончанияРемонта) И НЕ ПустаяСтрока(СокрЛП(РезультатРемонта)) Тогда	
		Сообщить("Для указанного результата необходимо заполнить дату окончания ремонта.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДатаОкончанияРемонта) И ЗначениеЗаполнено(СостояниеПослеРемонта) Тогда
		Сообщить("Состояние после ремонта можно указывать только при заполненной дате окончания ремонта.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если СтоимостьРемонта < 0 Тогда
		Сообщить("Стоимость ремонта не может быть отрицательной.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения) 
	Если НЕ ЗначениеЗаполнено(Заявка) Тогда
		Сообщить("Не указана связанная заявка.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Оборудование) Тогда
		Сообщить("Не указано оборудование.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ПричинаРемонта)) Тогда
		Сообщить("Не указана причина ремонта.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Оформил) Тогда
		Сообщить("Не указан сотрудник, оформивший ремонт.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ДанныеЗаявки = УправлениеОборудованиемСервер.ПолучитьДанныеЗаявкиДляРаботыСОборудованием(Заявка);

	Если ДанныеЗаявки = Неопределено Тогда
		Сообщить("Не удалось получить данные связанной заявки.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ДанныеЗаявки.ТекущийСтатус <> Перечисления.СтатусыЗаявок.ОжидаетОборудование Тогда		
		Сообщить("Передача оборудования в ремонт возможна только по заявке в статусе ""Ожидает оборудование"".");			
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ДанныеЗаявки.Оборудование) ИЛИ Оборудование <> ДанныеЗаявки.Оборудование Тогда	
		Сообщить("В ремонт необходимо передать проблемное оборудование, указанное в заявке.");			
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	МоментДоДокумента = Новый Граница(МоментВремени(), ВидГраницы.Исключая);
	ТекущееСостояние = УправлениеОборудованиемСервер.ПолучитьТекущееСостояниеОборудования(Оборудование, МоментДоДокумента, Ссылка);

	Если ТекущееСостояние = Неопределено Тогда
		Сообщить("Не удалось определить текущее состояние оборудования.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ТекущееСостояние.Состояние <> Перечисления.СостоянияОборудования.Используется Тогда		
		Сообщить("Передать в ремонт можно только оборудование, которое находится в использовании.");		
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ТекущееСостояние.ЗакрепленоЗа <> ДанныеЗаявки.Заявитель Тогда
		Сообщить("Оборудование не закреплено за заявителем связанной заявки.");		
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Движения.ИсторияСостоянийОборудования.Записывать = Истина;

	КомментарийНачала = "Передано в ремонт. Причина: " + СокрЛП(ПричинаРемонта);

	Если НЕ ПустаяСтрока(СокрЛП(Комментарий)) Тогда
		КомментарийНачала = КомментарийНачала + " " + СокрЛП(Комментарий);
	КонецЕсли;

	Движение = Движения.ИсторияСостоянийОборудования.Добавить();

	Движение.Период = Дата;
	Движение.Оборудование = Оборудование;
	Движение.Состояние = Перечисления.СостоянияОборудования.ВРемонте;
	Движение.ЗакрепленоЗа = Справочники.Сотрудники.ПустаяСсылка();
	Движение.Заявка = Заявка;
	Движение.Комментарий = КомментарийНачала;
	Движение.Оформил = Оформил;

	Если ЗначениеЗаполнено(ДатаОкончанияРемонта) Тогда

		КомментарийОкончания = "Ремонт завершён. Результат: " + СокрЛП(РезультатРемонта);

		Движение = Движения.ИсторияСостоянийОборудования.Добавить();

		Движение.Период = ДатаОкончанияРемонта;
		Движение.Оборудование = Оборудование;
		Движение.Состояние = СостояниеПослеРемонта;
		Если СостояниеПослеРемонта = Перечисления.СостоянияОборудования.Используется Тогда
			Движение.ЗакрепленоЗа = ТекущееСостояние.ЗакрепленоЗа;
		Иначе
			Движение.ЗакрепленоЗа = Справочники.Сотрудники.ПустаяСсылка();
		КонецЕсли;
		
		Движение.Заявка = Заявка;
		Движение.Комментарий = КомментарийОкончания;
		Движение.Оформил = Оформил;
	КонецЕсли;

КонецПроцедуры
