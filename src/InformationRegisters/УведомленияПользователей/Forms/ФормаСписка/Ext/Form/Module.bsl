 &НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЭтоАдминистратор = РольДоступна("АдминистраторСистемы");

	Если ЭтоАдминистратор Тогда
		НастроитьРежимЖурналаУведомлений();
		Возврат;
	КонецЕсли;

	НастроитьРежимМоихУведомлений();

	ТекущийСотрудник =
		УправлениеПользователямиСервер.ПолучитьТекущегоСотрудника();

	Если ТекущийСотрудник = Неопределено Тогда
		Сообщить("Пользователь ИБ не связан с активным сотрудником.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ЭлементОтбора =
		Список.КомпоновщикНастроек.ФиксированныеНастройки
			.Отбор.Элементы.Добавить(
				Тип("ЭлементОтбораКомпоновкиДанных"));

	ЭлементОтбора.ЛевоеЗначение =
		Новый ПолеКомпоновкиДанных("Получатель");

	ЭлементОтбора.ВидСравнения =
		ВидСравненияКомпоновкиДанных.Равно;

	ЭлементОтбора.ПравоеЗначение = ТекущийСотрудник;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры    

&НаСервере
Процедура НастроитьРежимЖурналаУведомлений()

	Заголовок = "Журнал уведомлений";

	Элементы.Получатель.Видимость = Истина;
	Элементы.ДатаПоказа.Видимость = Истина;
	Элементы.Обработано.Видимость = Истина;
	Элементы.ДатаОбработки.Видимость = Истина;

	Элементы.ФормаОтметитьПрочитанным.Видимость = Ложь;

КонецПроцедуры

&НаСервере
Процедура НастроитьРежимМоихУведомлений()

	Заголовок = "Мои уведомления";

	Элементы.Получатель.Видимость = Ложь;
	Элементы.ДатаПоказа.Видимость = Ложь;
	Элементы.Обработано.Видимость = Ложь;
	Элементы.ДатаОбработки.Видимость = Ложь;

	Элементы.ФормаОтметитьПрочитанным.Видимость = Истина;

КонецПроцедуры    

&НаКлиенте
Процедура ОтметитьПрочитанным(Команда)

	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;

	Если ТекущаяСтрока = Неопределено Тогда
		Сообщить("Выберите уведомление.");
		Возврат;
	КонецЕсли;

	УведомлениеПрочитано =
		УправлениеУведомлениямиВызовСервера
			.ОтметитьУведомлениеПрочитанным(
				ТекущаяСтрока.Период,
				ТекущаяСтрока.Заявка,
				ТекущаяСтрока.ТипУведомления);

	Если УведомлениеПрочитано Тогда
		Элементы.Список.Обновить();
	Иначе
		Сообщить("Не удалось отметить уведомление прочитанным.");
	КонецЕсли;

КонецПроцедуры